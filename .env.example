CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=<CLICKUP_LIST_ID>

# All three conditions must match.
CLICKUP_TASK_TYPE=bug
CLICKUP_TASK_TYPE_ID=<CLICKUP_TASK_TYPE_ID>
CLICKUP_TICKET_TYPE_FIELD_ID=00000000-0000-0000-0000-000000000001
CLICKUP_TICKET_TYPE_FIELD=Tipo do ticket
CLICKUP_TICKET_TYPE_VALUE=bug
CLICKUP_AREA_FIELD_ID=00000000-0000-0000-0000-000000000006
CLICKUP_AREA_FIELD=Área
# JSON array of every ClickUp area processed by this instance.
CLICKUP_AREA_VALUES=["EN","NOVA_AREA"]
# Legacy single-area fallback, used only when CLICKUP_AREA_VALUES is empty.
CLICKUP_AREA_VALUE=
CLICKUP_VECTORS_FIELD_ID=00000000-0000-0000-0000-000000000002
CLICKUP_VECTORS_FIELD=Vetores
# Canonical diagnosis vector -> description included in the Codex prompt.
DIAGNOSIS_VECTORS={"Sequências":"criação, configuração ou execução de sequências e suas etapas","Conversas/Métricas":"mensagens, conversas, respostas, caixas de entrada, eventos e métricas derivados dessas interações","Conexões":"autenticação, integração, conta conectada, sessão ou disponibilidade de um canal externo"}
CLICKUP_IN_DEVELOPMENT_STATUS=7. em desenvolvimento

# Optional comma-separated filters. Empty means no extra filter.
CLICKUP_STATUSES=
CLICKUP_TAGS=
CLICKUP_INCLUDE_SUBTASKS=true
CLICKUP_CREATED_WITHIN_MINUTES=60
CLICKUP_MAX_TICKETS=3
CLICKUP_MAX_ATTACHMENTS=10
CLICKUP_MAX_ATTACHMENT_MB=20
# Nest child-process slots. Set to 1 for operational rollback to serial execution.
DIAGNOSIS_EXECUTION_CONCURRENCY=2
# Codex workers inside one automatic ticket batch.
RUNNER_CONCURRENCY=3

DRIVA_REPOS_DIR=/home/usuario/Documents/projects/driva-ops-agent/repos
CODEX_BIN=codex
CODEX_HOME=
CODEX_MODEL=gpt-5.6-sol
DRIVA_PROXY_API_KEY=
CODEX_TIMEOUT_MINUTES=45
# Agent runtime: codex or claude. AGENT_RUNTIME_<SURFACE> overrides it per surface.
AGENT_RUNTIME=codex
# Surfaces: DIAGNOSIS, REMEDIATION, CONVERSATION, COMMUNICATION, IMPACT.
AGENT_RUNTIME_CONVERSATION=
# Keep the claude/ prefix: other proxy routes may serve a different model.
CLAUDE_MODEL=claude/claude-opus-5-5
CLAUDE_SMALL_MODEL=claude/claude-haiku-5-5
CLAUDE_EFFORT=high
CLAUDE_BASE_URL=http://vpn-host2.example.internal:8317
CLAUDE_BIN=claude
# Comma-separated extra paths visible inside the read sandbox.
CLAUDE_READ_ONLY_PATHS=
REMEDIATION_TIMEOUT_MINUTES=90
REPOSITORY_SYNC_TIMEOUT_MINUTES=5
# Customer impact runner (npm run impact). Timeouts in ms; default 900000.
IMPACT_CODEX_SANDBOX_MODE=
IMPACT_CODEX_TIMEOUT_MS=
# Fallback timeout for the impact runner when IMPACT_CODEX_TIMEOUT_MS is empty.
CODEX_TIMEOUT_MS=
# GitHub authentication: static (rollback/local) or app (production).
GITHUB_AUTH_MODE=app

# Static mode only.
GH_TOKEN=

# App mode only. Mount the private key read-only; never store its contents here.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_ORGANIZATION=Example-org
# Repository name used by /health/dependencies to verify selected-repository access.
GITHUB_APP_HEALTH_REPOSITORY=service-15
GITHUB_APP_PRIVATE_KEY_FILE=/app/secrets/github-app-private-key.pem
# Optional: auto-discovered from the organization when empty.
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_TOKEN_REFRESH_SKEW_SECONDS=300

# Commit identity is independent from the GitHub App bot authentication identity.
GIT_AUTHOR_NAME=
GIT_AUTHOR_EMAIL=
GIT_COMMITTER_NAME=
GIT_COMMITTER_EMAIL=
# Paths relative to DRIVA_REPOS_DIR. Ignoring a repository does not ignore nested repositories.
REPOSITORY_SYNC_IGNORE=service-09
DEPENDENCY_SYNC_ENABLED=true
# Per-project timeout. Installs run only when a lockfile changes or dependencies are missing.
DEPENDENCY_SYNC_TIMEOUT_MINUTES=30
# Dedicated read-only GitHub Packages token required by service-17's .npmrc.
# This credential is independent and is not replaced by GitHub App authentication.
GITHUB_DDS_TOKEN=

# Read-only operational sources used by repository-local diagnosis skills.
SALES_POSTGRESQL_HOST=
SALES_POSTGRESQL_PORT=5432
SALES_POSTGRESQL_USERNAME=
SALES_POSTGRESQL_PASSWORD=
SALES_POSTGRESQL_DATABASE=
CLICKHOUSE_URL=
# Optional alias for CLICKHOUSE_URL. Configure only one of them.
HYPERDX_CLICKHOUSE_URL=
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_LOGS_TABLE=
CLICKHOUSE_DEFAULT_LIMIT=50
CLICKHOUSE_MAX_ROWS=200
CLICKHOUSE_QUERY_TIMEOUT_MS=30000
CLICKHOUSE_REQUIRE_TIME_WINDOW=true

# Read-only database credentials materialized into repository-local .env files
# immediately before diagnosis. Configure complete groups only.
# The engagement ClickHouse credentials above are shared by the management
# and service-10 log skills through the process environment.
HUNTER_DATABASE_READONLY_URL=
INTEGRATIONS_PG_HOST=
INTEGRATIONS_PG_PORT=5432
INTEGRATIONS_PG_USER=
INTEGRATIONS_PG_PASSWORD=
INTEGRATIONS_PG_DATABASE=
# Exports database: integrations (--target exports) and the service-12 .env.
INTEGRATIONS_EXPORTS_PG_HOST=
INTEGRATIONS_EXPORTS_PG_PORT=
INTEGRATIONS_EXPORTS_PG_USER=
INTEGRATIONS_EXPORTS_PG_PASSWORD=
INTEGRATIONS_EXPORTS_PG_DATABASE=
INTEGRATIONS_CLIENTS_PG_HOST=
INTEGRATIONS_CLIENTS_PG_PORT=
INTEGRATIONS_CLIENTS_PG_USER=
INTEGRATIONS_CLIENTS_PG_PASSWORD=
INTEGRATIONS_CLIENTS_PG_DATABASE=
# Logs ClickHouse shared by the integrations, service-12 and service-13 skills.
DRIVA_LOGS_CH_HOST=
DRIVA_LOGS_CH_PORT=
DRIVA_LOGS_CH_PROTOCOL=
DRIVA_LOGS_CH_USER=
DRIVA_LOGS_CH_PASSWORD=
LINKEDIN_DATABASE_URL=
MAIL_POSTGRES_HOST=
MAIL_POSTGRES_PORT=5432
MAIL_POSTGRES_USERNAME=
MAIL_POSTGRES_PASSWORD=
MAIL_POSTGRES_DATABASE=
MAIL_POSTGRES_SCHEMA=
MANAGEMENT_PG_HOST=
MANAGEMENT_PG_PORT=5432
MANAGEMENT_PG_USER=
MANAGEMENT_PG_PASSWORD=
MANAGEMENT_PG_DATABASE=
MARKET_INTELLIGENCE_STORAGE_S3_BUCKET=
MARKET_INTELLIGENCE_STORAGE_S3_REGION=
MARKET_INTELLIGENCE_STORAGE_S3_ENDPOINT_URL=
MARKET_INTELLIGENCE_STORAGE_S3_USE_PATH_STYLE=
MARKET_INTELLIGENCE_STORAGE_S3_ACCESS_KEY_ID=
MARKET_INTELLIGENCE_STORAGE_S3_SECRET_ACCESS_KEY=
DRIVA_LIST_PG_HOST=
DRIVA_LIST_PG_PORT=5432
DRIVA_LIST_PG_DATABASE=
DRIVA_LIST_PG_USER=
DRIVA_LIST_PG_PASSWORD=
DRIVA_SEARCH_CH_HOST=
DRIVA_SEARCH_CH_PORT=
DRIVA_SEARCH_CH_USER=
DRIVA_SEARCH_CH_PASSWORD=
DRIVA_RABBITMQ_MANAGEMENT_URL=
DRIVA_RABBITMQ_MANAGEMENT_USER=
DRIVA_RABBITMQ_MANAGEMENT_PASSWORD=
WHATSAPP_CLOUD_POSTGRES_HOST=
WHATSAPP_CLOUD_POSTGRES_PORT=5432
WHATSAPP_CLOUD_POSTGRES_USERNAME=
WHATSAPP_CLOUD_POSTGRES_PASSWORD=
WHATSAPP_CLOUD_POSTGRES_DATABASE=
WHATSAPP_CLOUD_POSTGRES_SSLMODE=

# NestJS API and hourly diagnosis cron.
HOST=0.0.0.0
PORT=3000
DIAGNOSIS_CRON=*/5 * * * *
# Only true or false; keep false during deployment validation, enable after manual checks pass.
DIAGNOSIS_CRON_ENABLED=false
# Closes agent PRs (results/**/remediation.json) idle for STALE_PR_MAX_AGE_DAYS, deleting the branch, and
# agent issues (results/**/github-issues.json) idle for STALE_ISSUE_MAX_AGE_DAYS, unless assigned or with an open linked PR.
STALE_PR_CLEANUP_ENABLED=false
STALE_PR_CLEANUP_CRON=17 9 * * *
STALE_PR_MAX_AGE_DAYS=14
STALE_ISSUE_MAX_AGE_DAYS=30
# Daily storage maintenance stays disabled until manual calibration defines both cache limits.
STORAGE_MAINTENANCE_ENABLED=false
STORAGE_MAINTENANCE_CRON=43 3 * * *
STORAGE_DEPENDENCY_CACHE_HIGH_MB=
STORAGE_DEPENDENCY_CACHE_TARGET_MB=
STORAGE_WORKTREE_MIN_AGE_HOURS=24
STORAGE_MAINTENANCE_TIMEOUT_MINUTES=90
# Bearer token accepted by POST /diagnoses and GET /diagnoses/:runId.
DIAGNOSIS_API_KEY=
# Bearer token accepted by POST /incidents/grafana.
GRAFANA_WEBHOOK_TOKEN=

# Application Default Credentials or GOOGLE_APPLICATION_CREDENTIALS must point
# to the Google service account used by the Chat app.
GOOGLE_APPLICATION_CREDENTIALS=
# Numeric Google Cloud project number (not the project ID and not the service account email).
GOOGLE_CLOUD_PROJECT_NUMBER=
# Exact HTTP interaction endpoint URL configured as Authentication Audience.
GOOGLE_CHAT_AUDIENCE=
# Optional callback URL used by card actions. Defaults to GOOGLE_CHAT_AUDIENCE.
GOOGLE_CHAT_ACTION_URL=
# Service Account Email from Marketplace SDK > HTTP Deployments > Authorization Resource.
GOOGLE_CHAT_CALLER_EMAIL=
GOOGLE_CHAT_SKIP_AUTH=false
# Slash command ID configured for /processar in the Google Chat API.
GOOGLE_CHAT_PROCESS_COMMAND_ID=1
# Slash command ID configured for /comunicacao in the Google Chat API.
GOOGLE_CHAT_COMMUNICATION_COMMAND_ID=2
# Space (spaces/XXXX) that receives /comunicacao news posts.
GOOGLE_CHAT_NEWS_SPACE=
# Optional Codex model for /comunicacao. Defaults to CODEX_MODEL.
COMMUNICATION_CODEX_MODEL=
# Timeout in minutes for each /comunicacao run; each Codex attempt gets about half.
COMMUNICATION_TIMEOUT_MINUTES=20
# Optional S3-compatible storage for /comunicacao images. Empty bucket turns images off.
COMMUNICATION_MEDIA_S3_BUCKET=
COMMUNICATION_MEDIA_S3_REGION=
COMMUNICATION_MEDIA_S3_ENDPOINT=
COMMUNICATION_MEDIA_S3_ACCESS_KEY_ID=
COMMUNICATION_MEDIA_S3_SECRET_ACCESS_KEY=
# Base URL of published objects, e.g. https://<bucket>.s3.<region>.example-cloud.net
COMMUNICATION_MEDIA_S3_PUBLIC_BASE_URL=
# Optional ISO cutoff. Empty means retry every successful result not marked as sent.
GOOGLE_CHAT_NOTIFY_AFTER=
# Ticket-thread diagnostic conversation defaults.
GOOGLE_CHAT_CONVERSATION_HISTORY_TURNS=10
GOOGLE_CHAT_CONVERSATION_MAX_MESSAGE_LENGTH=4000
GOOGLE_CHAT_CONVERSATION_TIMEOUT_MINUTES=10
GOOGLE_CHAT_REORIENTATION_MAX_MESSAGE_LENGTH=4000
GOOGLE_CHAT_REORIENTATION_CONFIRMATION_MINUTES=60

# EN vectors confirmed in ClickUp. They may initially point to the same space.
GOOGLE_CHAT_VECTOR_SPACES_JSON={"Sequências":["spaces/AAAA"],"Conversas/Métricas":["spaces/AAAA"],"Conexões":["spaces/AAAA"]}

# Google Chat e-mail -> GitHub login. Sem mapeamento o aviso no Chat continua
# sendo publicado, mas a issue do incidente fica sem assignee.
GITHUB_CHAT_USER_MAP={"pessopessoa1@example.com":"login-github"}
